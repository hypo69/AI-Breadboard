{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "tc": {
        "name": "Test Computer (tc)",
        "description": "Configuration profile for test computer apps runner (tc.ps1)"
    },
    "server": {
        "host": "127.0.0.1",
        "port": 8080,
        "protocol": "https",
        "use_ssl": true,
        "open_browser": true,
        "enable_oauth": true
    },
    "ai": {
        "gemini": {
            "model": "gemini-2.5-flash"
        },
        "gemini_cli": {
            "model": "gemini-3.1-flash-lite"
        },
        "agy": {
            "model": "gemini-3.6-flash",
            "effort": "medium"
        },
        "provider": "gemini"
    },
    "apps": {
      "enabled": [
        "about_system",
        "scenarios",
        "windows_sysadmin",
        "system_inspector",
        "system_control_center",
        "system_log_viewer",
        "software_audit",
        "registry_viewer",
        "windows_startup_auditor",
        "windows_defender",
        "windows_backup_manager",
        "hardware_monitor",
        "smartmontools",
        "librehardwaremonitor",
        "autolog_manager",
        "network_terminal",
        "ai_benchmark"
      ],
      "disabled": [
        "chat",

        "cloudflared_monitor",
        "gcloud_monitor",
        "website_monitor",
        "user_assistant",
        "wikipedia_research",
        "trading_terminal",
        "helpdesk",
        "lawyer_assistant",
        "ai_breadboard_admin",
        "research_and_statistic",
        "tshark"
      ]
    },
    "plugins": {
        "enabled": [],
        "disabled": [
            "application_log_analyzer",
            "facebook",
            "gdrive_sync",
            "generate_rag_from_codebase",
            "google_workspace",
            "ifttt",
            "invoice_processor",
            "news_feed",
            "rag_cleaner",
            "telegram_bot",
            "telegram_channel_rag",
            "user_storage"
        ]
    },
    "logging": {
        "enable_autolog": true,
        "default_interval": "1 minute",
        "loggers": {
            "system_inspector": {
                "interval": "5 seconds",
                "enabled": true
            },
            "hardware_monitor": {
                "interval": "5 seconds",
                "enabled": true
            },
            "librehardwaremonitor": {
                "interval": "5 seconds",
                "enabled": true
            },
            "smartmontools": {
                "interval": "10 minutes",
                "enabled": false
            },
            "website_monitor": {
                "interval": "5 minutes",
                "enabled": false
            },
            "gcloud_monitor": {
                "interval": "5 minutes",
                "enabled": false
            },
            "cloudflared_monitor": {
                "interval": "30 seconds",
                "enabled": false
            },
            "windows_sysadmin": {
                "interval": "1 minute",
                "enabled": true
            },
            "windows_defender": {
                "interval": "12 hour",
                "enabled": true
            },
            "windows_startup_auditor": {
                "interval": "1 hour",
                "enabled": true
            },
            "windows_backup_manager": {
                "interval": "6 hours",
                "enabled": true
            },
            "trading_terminal": {
                "interval": "10 seconds",
                "enabled": false
            },
            "user_assistant": {
                "interval": "5 minutes",
                "enabled": false
            },
            "helpdesk": {
                "interval": "1 minute",
                "enabled": false
            },
            "registry_viewer": {
                "interval": "12 hour",
                "enabled": true
            },
            "software_audit": {
                "interval": "1 hour",
                "enabled": true
            }
        }
    }
}