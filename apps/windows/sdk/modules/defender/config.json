{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "app_name": "Windows Defender & AI Security Diagnostic Center",
  "version": "1.0.0",
  "port": 8113,
  "api_prefix": "/api/v1/defender",
  "enabled": true,
  "mpcmdrun_scan_timeout_seconds": 120,
  "events_fetch_limit": 50,
  "threats_fetch_limit": 50,
  "alert_on_critical_exclusions": true,
  "default_protected_folders": [
    "~\\Documents",
    "~\\Pictures",
    "~\\Videos",
    "~\\Music",
    "~\\Desktop",
    "~\\Favorites"
  ]
}
