    },
    "server": {
        "host": "127.0.0.1",
        "port": 8001,
        "protocol": "http",
        "title": "AI-Breadboard Windows Internal API",
        "description": "\u0421\u0435\u0440\u0432\u0438\u0441 TC/Windows: \u0442\u0435\u043b\u0435\u043c\u0435\u0442\u0440\u0438\u044f, \u0434\u0430\u0448\u0431\u043e\u0440\u0434\u044b, \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0430.",
