{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Единая конфигурация телеметрии: сенсоры, логгеры приложений и опции сбора данных",
  "mode": "hybrid",
  "buffer_mode": "memory",
  "buffer_size": 50,
  "flush_interval_seconds": 30.0,
  "buffer_file": "telemetry_buffer.jsonl",
  "max_db_size_mb": 50.0,
  "retention_days": 7,
  "db_cleanup_interval_seconds": 300.0,
  "auto_vacuum_enabled": true,
  "interval_seconds": 6.0,
  "heavy_interval_seconds": 90.0,
  "process_mode": "top_n",
  "top_processes": 10,
  "low_priority": true,
  "fast_interval_seconds": 30,
  "fast_duration_days": 2,
  "aggregation_interval_seconds": 3600,
  "max_file_size_mb": 50,
  "max_measurements": null,
  "heavy_disk_scan_interval_seconds": 43200,
  "heavy_mode_max_duration_days": 5,
  "heavy_mode_auto_switch_enabled": true,
  "watch_directories": [
    "C:\\Users\\"
  ],
  "log_filename": "ai_sensors_polls.json",
  "collect_serial_numbers": true,
  "collect_hardware_inventory": false,
  "collect_file_events": false,
  "heavy_collectors": {
    "hardware_sensors": true,
    "storage_smart": true,
    "network_ping": true,
    "inventory_wmi": true
  },
  "enable_autolog": true,
  "default_interval": "1 minute",
  "loggers": {
    "system_inspector": {
      "interval": "5 seconds",
      "enabled": true
    },
    "hardware_monitor": {
      "interval": "5 seconds",
      "enabled": true
    },
    "windows_sysadmin": {
      "interval": "1 minute",
      "enabled": true
    },
    "windows_defender": {
      "interval": "1 hour",
      "enabled": true
    },
    "windows_startup_auditor": {
      "interval": "1 hour",
      "enabled": true
    },
    "windows_backup_manager": {
      "interval": "6 hours",
      "enabled": true
    },
    "registry_viewer": {
      "interval": "1 hour",
      "enabled": true
    },
    "software_audit": {
      "interval": "1 hour",
      "enabled": true
    },
    "website_monitor": {
      "interval": "5 minutes",
      "enabled": false
    },
    "gcloud_monitor": {
      "interval": "5 minutes",
      "enabled": false
    },
    "cloudflared_monitor": {
      "interval": "30 seconds",
      "enabled": false
    },
    "trading_terminal": {
      "interval": "10 seconds",
      "enabled": false
    },
    "user_assistant": {
      "interval": "5 minutes",
      "enabled": false
    },
    "helpdesk": {
      "interval": "1 minute",
      "enabled": false
    }
  },
  "sensors": {
    "cpu": {
      "enabled": true,
      "interval_seconds": 5.0,
      "metrics": [
        "temperature",
        "load",
        "clocks"
      ]
    },
    "gpu": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "load",
        "memory",
        "power"
      ]
    },
    "ram": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "usage",
        "swap"
      ]
    },
    "disk": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "usage",
        "io"
      ]
    },
    "network": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "throughput",
        "connections"
      ]
    },
    "sensors": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "fan",
        "voltage"
      ]
    },
    "internet": {
      "enabled": true,
      "interval_seconds": 120.0,
      "metrics": [
        "ping",
        "download",
        "upload",
        "dns"
      ]
    },
    "storage": {
      "enabled": true,
      "interval_seconds": 32000.0,
      "metrics": [
        "smart_attributes",
        "temperature",
        "wear_level"
      ]
    },
    "device_flapping": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "connect_events",
        "disconnect_events",
        "flapping_count"
      ]
    }
  },
  "telemetry_options": {
    "collect_serial_numbers": true,
    "collect_hardware_inventory": true,
    "collect_file_events": true,
    "max_file_size_mb": 50,
    "watch_directories": [
      "C:\\Users\\"
    ]
  },
  "w64_collector": {
    "enabled": true,
    "enable_file_monitoring": true,
    "enable_process_monitoring": true,
    "enable_registry_monitoring": true,
    "enable_network_monitoring": true,
    "enable_event_log_monitoring": true,
    "enable_process_trace": true,
    "enable_disk_trace": true,
    "enable_network_trace": true,
    "enable_registry_trace": true
  }
}