{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Единая конфигурация телеметрии: сенсоры, логгеры приложений и опции сбора данных",
  "storage": {
    "data_path": "%ProgramData%/AI-Breadboard/apps/windows/telemetry/logs",
    "db_path": "%ProgramData%/AI-Breadboard/apps/windows/telemetry/logs/telemetry.db"
  },
  "data_path": "%ProgramData%/AI-Breadboard/apps/windows/telemetry/logs",
  "mode": "hybrid",
  "telemetry_mode": "telemetry",
  "standard_flush_interval_seconds": 30.0,
  "tc_flush_interval_seconds": 5.0,
  "tc_mode_timeout_seconds": 300.0,
  "tc_mode_activated_at": null,
  "buffer_mode": "memory",
  "buffer_size": 50,
  "flush_interval_seconds": 30.0,
  "buffer_file": "telemetry_buffer.jsonl",
  "max_db_size_mb": 100.0,
  "retention_days": 7,
  "db_cleanup_interval_seconds": 300.0,
  "auto_vacuum_enabled": true,
  "interval_seconds": 6.0,
  "heavy_interval_seconds": 90.0,
  "process_mode": "top_n",
  "top_processes": 10,
  "low_priority": true,
  "fast_interval_seconds": 3.0,
  "fast_duration_days": 2,
  "aggregation_interval_seconds": 3600,
  "max_file_size_mb": 50,
  "max_measurements": null,
  "heavy_disk_scan_interval_seconds": 43200,
  "heavy_mode_max_duration_days": 5,
  "heavy_mode_auto_switch_enabled": true,
  "watch_directories": [
    "C:\\Users\\"
  ],
  "log_filename": "ai_sensors_polls.json",
  "collect_serial_numbers": true,
  "collect_hardware_inventory": false,
  "collect_file_events": false,
  "heavy_collectors": {
    "hardware_sensors": true,
    "storage_smart": true,
    "network_ping": true,
    "inventory_wmi": true
  },
  "sensors": {
    "cpu": {
      "enabled": true,
      "interval_seconds": 5.0,
      "metrics": [
        "temperature",
        "load",
        "clocks"
      ]
    },
    "gpu": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "load",
        "memory",
        "power"
      ]
    },
    "ram": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "usage",
        "swap"
      ]
    },
    "disk": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "usage",
        "io"
      ]
    },
    "network": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "throughput",
        "connections"
      ]
    },
    "sensors": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "fan",
        "voltage"
      ]
    },
    "internet": {
      "enabled": true,
      "interval_seconds": 3600.0,
      "metrics": [
        "ping",
        "download",
        "upload",
        "bufferbloat",
        "latency_loaded"
      ]
    },
    "storage": {
      "enabled": true,
      "interval_seconds": 32000.0,
      "metrics": [
        "smart_attributes",
        "temperature",
        "wear_level"
      ]
    },
    "device_flapping": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "connect_events",
        "disconnect_events",
        "flapping_count"
      ]
    }
  },
  "telemetry_options": {
    "collect_serial_numbers": true,
    "collect_hardware_inventory": true,
    "collect_file_events": true,
    "max_file_size_mb": 50,
    "watch_directories": [
      "C:\\Users\\"
    ]
  },
  "w64_collector": {
    "enabled": true,
    "enable_file_monitoring": true,
    "enable_process_monitoring": true,
    "enable_registry_monitoring": true,
    "enable_network_monitoring": true,
    "enable_event_log_monitoring": true,
    "enable_process_trace": true,
    "enable_disk_trace": true,
    "enable_network_trace": true,
    "enable_registry_trace": true
  }
}
