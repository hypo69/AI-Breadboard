{
  "app_name": "Website Intelligence Monitor",
  "version": "1.0.0",
  "server": {
    "dedicated": false,
    "host": "127.0.0.1",
    "port": 8107,
    "use_ssl": false,
    "workers": 1
  },
  "default_property_id": "properties/123456789",
  "target_site_url": "https://example.com",
  "auth": {
    "prefer_oauth": true,
    "service_account_file": "service_account.json",
    "fallback_to_mock": true
  },
  "anomaly_thresholds": {
    "traffic_drop_percent": 20.0,
    "conversion_drop_percent": 15.0,
    "error_404_spike_percent": 100.0,
    "error_5xx_threshold": 5,
    "latency_p95_ms": 800.0
  },
  "refresh_interval_seconds": 10,
  "tracked_endpoints": [
    "/",
    "/products",
    "/pricing",
    "/checkout",
    "/blog",
    "/contact"
  ]
}