# Пример файла переменных окружения проекта.
# Этот файл служит шаблоном для локальной настройки среды разработки,
# включая токены, ключи API и параметры интеграций без хранения
# реальных секретов в репозитории.

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.ngrok-free.dev/auth/google/callback

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Ngrok (NEVER COMMIT THIS TO GIT)
NGROCK_AUTOTOKEN=your_ngrok_authtoken_here

# Gemini API
GEMINI_API_KEY_NAMES=your_key_names_here

# Microsoft AI Foundry Configuration
USE_FOUNDRY=false
FOUNDRY_MODEL_ID=your_model_id_here
FOUNDRY_BASE_URL=http://localhost:54837
FOUNDRY_API_KEY=your_foundry_api_key_here

# Plugins
DISABLED_PLUGINS=

# Токен HuggingFace
HF_TOKEN=your_hf_token_here

# Text-to-Speech (TTS) voice setting (e.g. ru-RU-DmitryNeural, ru-RU-SvetlanaNeural)
TTS_VOICE=ru-RU-DmitryNeural

# LangChain / Google AI
GOOGLE_API_KEY=your_google_api_key_here
