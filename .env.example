# =============================================================================
# AI-Breadboard Environment Secrets Template (.env.example)
# =============================================================================
# Copy this file to `.env` and fill in your private API keys and tokens.
# Public configuration (ports, models, URLs, mode) resides in `config.json`.
# NEVER commit the real `.env` file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Gemini & Google GenAI SDK Configuration
# -----------------------------------------------------------------------------
# NOTE: The primary recommended way to manage Gemini API keys is via the key pool:
#       `src/secrets/gemini_keys.json` (supports multiple keys, status, and rotation).
#
# Optional fallback single key for Google GenAI / LangChain:
GOOGLE_API_KEY=your_google_gemini_api_key_here

# GEMINI_API_KEY_NAMES:
# Filter to select which keys from the pool/environment should be active.
#   *                 - Allow all detected keys in pool (recommended default)
#   GOOGLE_API_KEY    - Use only the key named GOOGLE_API_KEY
#   key1,key2         - Comma-separated list of specific key aliases
GEMINI_API_KEY_NAMES=*

# Optional Antigravity (AGY) API Key
# AGY_API_KEY=

# -----------------------------------------------------------------------------
# Local AI Providers (Microsoft AI Foundry & Ollama)
# -----------------------------------------------------------------------------
# Note: Endpoints (foundry_base_url, ollama_base_url), feature toggles
# (use_foundry, use_ollama) and model IDs are declared in `config.json`.
#
# Microsoft AI Foundry API Key (only needed if your Foundry instance requires auth)
FOUNDRY_API_KEY=

# -----------------------------------------------------------------------------
# Cloud AI Providers (OpenAI & HuggingFace)
# -----------------------------------------------------------------------------
# OpenAI API Key (endpoints and model lists are in `config.json` -> "openai_compat")
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Token (used for gated models or HF inference API)
HF_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# Security, Authentication & Sessions
# -----------------------------------------------------------------------------

# JWT secret for signing authentication tokens and sessions.
# A random secret key must be generated and kept private.
# It is used to verify that JWT tokens were issued by this application
# and have not been modified.
#
# Generate a secure secret key in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Copy the generated value to .env:
#   JWT_SECRET=<generated_secret>
#
# Never commit the real JWT_SECRET to Git or publish it.
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 (Optional)
ENABLE_OAUTH=false
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# Tunneling & Remote Access (Optional)
# -----------------------------------------------------------------------------
# User domain for client-facing web interface (e.g. kino.davidka.net)
USER_DOMAIN=kino.davidka.net

# Ngrok authtoken for exposing local breadboard server
NGROCK_AUTOTOKEN=your_ngrok_authtoken_here

# Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Notifications & Integrations (Optional)
# -----------------------------------------------------------------------------
# Telegram Bot Token for notifications/alerts
TELEGRAM_BOT_TOKEN=

# SMTP Configuration for email notifications / verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Documentation / Read the Docs token (Optional)
READTHEDOCS_API_TOKEN=
