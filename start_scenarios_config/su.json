{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "tc": {
        "name": "Test Computer (tc)",
        "description": "Configuration profile for test computer apps runner (Run-TC.ps1)"
    },
    "server": {
        "host": "127.0.0.1",
        "port": 8000,
        "protocol": "https",
        "use_ssl": true,
        "open_browser": true,
        "enable_oauth": true
    },
    "ai": {
        "providers": {
            "agy": {
                "enabled": false,
                "model": "agy-gemini-3.6-flash",
                "effort": "medium",
                "unsupported_models": []
            },
            "gemini": {
                "enabled": true,
                "model": "gemini-3.1-flash-lite",
                "api_key_names": "*",
                "unsupported_models": [
                    "gemini-1.0-pro",
                    "gemini-1.0-ultra",
                    "gemini-1.5-flash",
                    "gemini-1.5-pro",
                    "gemini-2.5-flash",
                    "gemini-2.5-flash-preview-tts",
                    "gemini-old"
                ]
            },
            "gemini_cli": {
                "enabled": true,
                "model": "gemini:gemini-3.1-flash-lite",
                "unsupported_models": []
            }
        }
    },
    "apps": {
      "enabled": [
       "chat",
      
       "user_assistant"
      ],
      "disabled": [
         "ai_breadboard_admin",
        "cloudflared_monitor",
        "gcloud_monitor",
        "website_monitor",
        "wikipedia_research",
        "trading_terminal",
        "helpdesk",
        "lawyer_assistant",
        "research_and_statistic",
        "tshark",
        "about_system",
        "scenarios",
        "windows_sysadmin",
        "network_terminal",
        "system_inspector",
        "system_control_center",
        "system_log_viewer",
        "software_audit",
        "registry_viewer",
        "windows_startup_auditor",
        "windows_defender",
        "windows_backup_manager",
        "hardware_monitor",
        "librehardwaremonitor",
        "autolog_manager",
        "ai_benchmark",
        "ninite_updater",
        "file_recovery"
      ]
    },
    "plugins": {
        "enabled": [],
        "disabled": [
            "application_log_analyzer",
            "facebook",
            "gdrive_sync",
            "generate_rag_from_codebase",
            "google_workspace",
            "ifttt",
            "invoice_processor",
            "news_feed",
            "rag_cleaner",
            "telegram_bot",
            "telegram_channel_rag",
            "user_storage"
        ]
    }
}