{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Единая конфигурация автологгирования приложений и сенсоров телеметрии",
  "enable_autolog": true,
  "default_interval": "1 minute",
  "loggers": {
    "system_inspector": {
      "interval": "5 seconds",
      "enabled": true
    },
    "hardware_monitor": {
      "interval": "5 seconds",
      "enabled": true
    },
    "librehardwaremonitor": {
      "interval": "5 seconds",
      "enabled": true
    },
    "windows_sysadmin": {
      "interval": "1 minute",
      "enabled": true
    },
    "windows_defender": {
      "interval": "1 hour",
      "enabled": true
    },
    "windows_startup_auditor": {
      "interval": "1 hour",
      "enabled": true
    },
    "windows_backup_manager": {
      "interval": "6 hours",
      "enabled": true
    },
    "registry_viewer": {
      "interval": "1 hour",
      "enabled": true
    },
    "software_audit": {
      "interval": "1 hour",
      "enabled": true
    },
    "website_monitor": {
      "interval": "5 minutes",
      "enabled": false
    },
    "gcloud_monitor": {
      "interval": "5 minutes",
      "enabled": false
    },
    "cloudflared_monitor": {
      "interval": "30 seconds",
      "enabled": false
    },
    "trading_terminal": {
      "interval": "10 seconds",
      "enabled": false
    },
    "user_assistant": {
      "interval": "5 minutes",
      "enabled": false
    },
    "helpdesk": {
      "interval": "1 minute",
      "enabled": false
    }
  },
  "sensors": {
    "cpu": {
      "enabled": true,
      "interval_seconds": 5.0,
      "metrics": [
        "temperature",
        "load",
        "clocks"
      ]
    },
    "gpu": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "load",
        "memory",
        "power"
      ]
    },
    "ram": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "usage",
        "swap"
      ]
    },
    "disk": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "usage",
        "io"
      ]
    },
    "network": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "throughput",
        "connections"
      ]
    },
    "sensors": {
      "enabled": true,
      "interval_seconds": 10.0,
      "metrics": [
        "temperature",
        "fan",
        "voltage"
      ]
    },
    "internet": {
      "enabled": true,
      "interval_seconds": 120.0,
      "metrics": [
        "ping",
        "download",
        "upload",
        "dns"
      ]
    },
    "storage": {
      "enabled": true,
      "interval_seconds": 32000.0,
      "metrics": [
        "smart_attributes",
        "temperature",
        "wear_level"
      ]
    },
    "device_flapping": {
      "enabled": true,
      "interval_seconds": 30.0,
      "metrics": [
        "connect_events",
        "disconnect_events",
        "flapping_count"
      ]
    }
  },
  "telemetry_options": {
    "collect_serial_numbers": true,
    "collect_hardware_inventory": true,
    "collect_file_events": true,
    "max_file_size_mb": 50,
    "watch_directories": [
      "C:\\Users\\"
    ]
  }
}